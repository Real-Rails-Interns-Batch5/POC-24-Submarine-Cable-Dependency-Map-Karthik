"use client";

import React, { useEffect, useState } from 'react';
import { useAppState } from '@/components/providers/AppStateProvider';
import { CABLES } from '@/lib/constants';
import { getFilteredCables, redundancyColor } from '@/lib/utils';
import { cn } from '@/lib/utils';

export function Sidebar() {
  const { state, dispatch } = useAppState();
  const { filters, selectedCable } = state;
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
  }, []);

  const filteredCables = getFilteredCables(CABLES, filters);

  const handleFilterChange = React.useCallback((key: keyof typeof state.filters, value: string) => {
    dispatch({ type: 'SET_FILTERS', payload: { [key]: value } });
  }, [dispatch]);

  const handleClearFilters = () => {
    dispatch({ type: 'SET_FILTERS', payload: { region: 'all', capacity: 'all', status: 'all' } });
  };

  const handleSelectCable = (id: string) => {
    if (selectedCable === id) {
      dispatch({ type: 'SET_SELECTED_CABLE', payload: null });
    } else {
      dispatch({ type: 'SET_SELECTED_CABLE', payload: id });
    }
  };

  return (
    <aside className="w-[252px] shrink-0 border-r border-[var(--border-subtle)] bg-[var(--depth-2)] overflow-y-auto overflow-x-hidden sidebar-scroll flex flex-col">
      
      {/* SECTION 1 — FILTERS */}
      <div className="flex flex-col px-[14px] pt-[14px] pb-[6px] border-b border-[var(--border-subtle)] shrink-0">
        <h2 className="text-[9px] font-bold text-[var(--text-muted)] uppercase tracking-[0.1em] mb-3">Filters</h2>
        
        <div className="flex flex-col gap-3">
          {/* Region */}
          <div className="flex flex-col">
            <label className="text-[10px] text-[var(--text-muted)] font-medium mb-[3px]">Region</label>
            <select 
              value={filters.region}
              onChange={(e) => handleFilterChange('region', e.target.value)}
              className="w-full bg-[var(--depth-3)] border border-[var(--border-subtle)] text-[var(--text-primary)] rounded-[6px] text-[12px] p-1.5 focus:outline-none focus:border-[var(--border-default)]"
            >
              <option value="all">All</option>
              <option value="transatlantic">Trans-Atlantic</option>
              <option value="transpacific">Trans-Pacific</option>
              <option value="indian-ocean">Indian Ocean</option>
            </select>
          </div>

          {/* Capacity */}
          <div className="flex flex-col">
            <label className="text-[10px] text-[var(--text-muted)] font-medium mb-[3px]">Capacity</label>
            <select 
              value={filters.capacity}
              onChange={(e) => handleFilterChange('capacity', e.target.value)}
              className="w-full bg-[var(--depth-3)] border border-[var(--border-subtle)] text-[var(--text-primary)] rounded-[6px] text-[12px] p-1.5 focus:outline-none focus:border-[var(--border-default)]"
            >
              <option value="all">All</option>
              <option value=">100">&gt;100 Tbps</option>
