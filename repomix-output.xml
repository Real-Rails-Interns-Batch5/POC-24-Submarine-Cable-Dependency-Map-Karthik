"use client";

import React, { useEffect, useState } from 'react';
import { useAppState } from '@/components/providers/AppStateProvider';
import { CABLES, COUNTRIES, OWNERS, LANDING_POINTS } from '@/lib/constants';

function getScoreColor(score: number) {
  if (score >= 75) return 'var(--accent-green)';
  if (score >= 40) return 'var(--accent-amber)';
  return 'var(--accent-red)';
}

const MOCK_COUNTRIES = COUNTRIES.map((c, i) => ({
  ...c,
  dep: [85, 62, 45, 30, 20, 15, 10, 5][i] || 0,
  red: [90, 65, 40, 20, 80, 50, 30, 10][i] || 0
}));

const MOCK_OWNERS = OWNERS.slice(0, 4).map((o, i) => ({
  ...o,
  share: [45, 30, 15, 10][i] || 0
}));

export function BottomStrip() {
  const { state, dispatch } = useAppState();
  const { activeTab, sim } = state;

  const [animate, setAnimate] = useState(false);
  
  useEffect(() => {
    setAnimate(false);
    let frame: number;
    const timeout = setTimeout(() => {
      frame = requestAnimationFrame(() => setAnimate(true));
    }, 50);
    return () => {
      clearTimeout(timeout);
      cancelAnimationFrame(frame);
    };
  }, [activeTab]);

  useEffect(() => {
    if (activeTab !== 'sim' && sim.running) {
      dispatch({ type: 'SET_SIM_STATE', payload: { running: false, cableId: null } });
    }
  }, [activeTab, sim.running, dispatch]);

  return (
    <div className="h-[200px] shrink-0 border-t border-[var(--border-subtle)] bg-[var(--depth-2)] flex flex-row w-full">
      {activeTab === 'map' && <MapPanels animate={animate} />}
      {activeTab === 'country' && <CountryPanels animate={animate} />}
      {activeTab === 'sim' && <SimPanels dispatch={dispatch} simState={sim} />}
    </div>
  );
}

function Panel({ title, children, flex = 1 }: { title: string, children: React.ReactNode, flex?: number }) {
  return (
    <div className="flex flex-col p-4 overflow-hidden shrink-0" style={{ flex }}>
      <h3 className="text-[9px] font-bold text-[var(--text-muted)] uppercase tracking-[0.1em]">{title}</h3>
      <div className="flex-1 flex flex-col min-h-0">
        {children}
      </div>
    </div>
  );
}

function MapPanels({ animate }: { animate: boolean }) {
  const top4 = MOCK_COUNTRIES.slice(0, 4);

  return (
    <>
      <Panel title="COUNTRY DEPENDENCY">
        <div className="flex flex-col justify-center h-full gap-3">
          {top4.map(c => (
            <div key={c.id} className="flex items-center text-[11px]">
              <span className="w-[82px] text-[var(--text-muted)] truncate shrink-0">{c.name}</span>
              <div className="flex-1 h-[5px] bg-[var(--depth-4)] rounded-full mx-3 overflow-hidden shrink-0">
                <div 
                  className="h-full rounded-full" 
                  style={{ 
                    width: animate ? `${c.dep}%` : '0%', 
                    backgroundColor: getScoreColor(c.red),
                    transition: 'width 0.6s cubic-bezier(0.4,0,0.2,1)'
                  }} 
                />
              </div>
              <span className="w-[30px] text-right text-[var(--text-primary)] shrink-0">{c.dep}%</span>
            </div>
          ))}
        </div>
      </Panel>
      <div className="w-[1px] bg-[var(--border-subtle)] shrink-0" />
      
      <Panel title="REDUNDANCY SCORE">
        <div className="flex flex-col justify-center h-full gap-3">
          {top4.map(c => (
            <div key={c.id} className="flex items-center text-[11px]">
              <span className="w-[82px] text-[var(--text-muted)] truncate shrink-0">{c.name}</span>
              <div className="flex-1 h-[5px] bg-[var(--depth-4)] rounded-full mx-3 overflow-hidden shrink-0">
                <div 
                  className="h-full rounded-full" 
                  style={{ 
                    width: animate ? `${c.red}%` : '0%', 
                    backgroundColor: getScoreColor(c.red),
                    transition: 'width 0.6s cubic-bezier(0.4,0,0.2,1)'
                  }} 
                />
              </div>
              <span className="w-[30px] text-right text-[var(--text-primary)] shrink-0">{c.red}</span>
            </div>
          ))}
        </div>
      </Panel>
      <div className="w-[1px] bg-[var(--border-subtle)] shrink-0" />

      <Panel title="CABLE OWNERSHIP">
        <div className="flex flex-col justify-center h-full gap-3">
          {MOCK_OWNERS.map(o => (
            <div key={o.id} className="flex items-center justify-between text-[11px]">
              <div className="flex items-center gap-2">
                <span className="text-[var(--text-primary)]">{o.name}</span>
                <span className="text-[9px] text-[var(--text-muted)] px-1 border border-[var(--border-subtle)] rounded-[3px]">
                  {o.type === 'private' ? 'Hyper' : 'Telco'}
                </span>
              </div>
              <div className="flex items-center">
                <div className="w-[70px] h-[5px] bg-[var(--depth-4)] rounded-full mx-3 overflow-hidden shrink-0">
                  <div 
                    className="h-full rounded-full" 
                    style={{ 
                      width: animate ? `${o.share}%` : '0%', 
                      backgroundColor: o.type === 'private' ? 'var(--accent-blue)' : 'var(--accent-teal)',
                      transition: 'width 0.6s cubic-bezier(0.4,0,0.2,1)'
                    }} 
                  />
                </div>
                <span className="w-[30px] text-right text-[var(--text-primary)] shrink-0">{o.share}%</span>
              </div>
            </div>
          ))}
        </div>
      </Panel>
    </>
  );
}

function CountryPanels({ animate }: { animate: boolean }) {
  return (
    <>
      <Panel title="ALL COUNTRIES — DEPENDENCY & REDUNDANCY" flex={2}>
        <div className="grid grid-cols-2 gap-x-8 gap-y-4 mt-4 pr-6">
          {MOCK_COUNTRIES.map(c => (
            <div key={c.id} className="flex items-center text-[11px]">
              <span className="w-[80px] text-[var(--text-muted)] truncate shrink-0">{c.name}</span>
              <div className="flex-1 h-[5px] bg-[var(--depth-4)] rounded-full mx-2 overflow-hidden relative shrink-0">
                <div 
                  className="absolute left-0 top-0 h-full rounded-full" 
                  style={{ 
                    width: animate ? `${c.red}%` : '0%', 
                    backgroundColor: getScoreColor(c.red),
                    transition: 'width 0.6s cubic-bezier(0.4,0,0.2,1)'
                  }} 
                />
              </div>
              <span className="w-[20px] text-right text-[var(--text-primary)] font-semibold shrink-0">{c.red}</span>
            </div>
          ))}
        </div>
      </Panel>
      <div className="w-[1px] bg-[var(--border-subtle)] shrink-0" />
      
      <Panel title="SCORING METHODOLOGY">
        <div className="flex flex-col justify-center h-full gap-2 text-[11px] text-[var(--text-primary)]">
          <div className="flex items-center gap-2">
            <span className="w-2 h-2 bg-[var(--accent-green)] shrink-0" />
            <span><strong className="w-[50px] inline-block shrink-0">75–100</strong> High — multiple redundant paths</span>
          </div>
          <div className="flex items-center gap-2">
            <span className="w-2 h-2 bg-[var(--accent-amber)] shrink-0" />
            <span><strong className="w-[50px] inline-block shrink-0">40–74</strong> Medium — some alternatives exist</span>
          </div>
          <div className="flex items-center gap-2">
            <span className="w-2 h-2 bg-[var(--accent-red)] shrink-0" />
            <span><strong className="w-[50px] inline-block shrink-0">0–39</strong> Low — single-path exposure</span>
          </div>
        
          <div className="mt-2 pt-2 border-t border-[var(--border-subtle)] text-[10px] text-[var(--text-ghost)] leading-[1.4]">
            Score = (active cables × capacity diversity) ÷ traffic demand proxy. 
            Synthetic calculation for demo. Production: RIPEstat BGP prefix coverage per ASN.
          </div>
        </div>
      </Panel>
    </>
  );
}

function SimPanels({ dispatch, simState }: { dispatch: any, simState: any }) {
  const [selectedCableId, setSelectedCableId] = useState<string>('');
  
  const simCables = CABLES.filter(c => c.status !== 'planned');

  const handleDropdownChange = React.useCallback((e: React.ChangeEvent<HTMLSelectElement>) => {
    setSelectedCableId(e.target.value);
    if (simState.running) {
      dispatch({ type: 'SET_SIM_STATE', payload: { running: false, cableId: null } });
    }
  }, [simState.running, dispatch]);

  const handleSimulate = React.useCallback(() => {
    if (!selectedCableId) return;
    dispatch({ type: 'SET_SIM_STATE', payload: { running: true, cableId: selectedCableId } });
  }, [selectedCableId, dispatch]);

  const handleReset = React.useCallback(() => {
    setSelectedCableId('');
    dispatch({ type: 'SET_SIM_STATE', payload: { running: false, cableId: null } });
  }, [dispatch]);

  const isRunning = simState.running && simState.cableId;
  const severedCable = CABLES.find(c => c.id === simState.cableId);

  const affectedLPs = isRunning && severedCable 
    ? LANDING_POINTS.filter(lp => severedCable.landingPoints.includes(lp.id))
    : [];

  const reroutes = isRunning && severedCable
    ? CABLES.filter(c => c.region === severedCable.region && c.status === 'active' && c.id !== severedCable.id)
    : [];

  // Critical (<40% redundancy proxy):
  const severity = reroutes.length <= 1 ? 'critical' : 'moderate';
  const severityColor = severity === 'critical' ? 'var(--accent-red)' : 'var(--accent-amber)';

  return (
    <>
      <Panel title="FAILURE SIMULATION">
        <div className="flex flex-col gap-3 mt-2">
          <select 
            value={selectedCableId}
            onChange={handleDropdownChange}
            className="w-full bg-[var(--depth-3)] border border-[var(--border-subtle)] text-[var(--text-primary)] rounded-[6px] text-[12px] p-2 focus:outline-none focus:border-[var(--border-default)]"
          >
            <option value="">Select a cable to cut...</option>
            {simCables.map(c => (
              <option key={c.id} value={c.id}>{c.name} — {c.capacityTbps}T ({c.status})</option>
            ))}
          </select>
          
          <div className="flex items-center gap-2 mt-1">
            <button 
              onClick={handleSimulate}
              disabled={!selectedCableId}
              className="px-3 py-1.5 text-[11px] text-[#ef4444] bg-transparent hover:bg-[rgba(239,68,68,0.1)] border border-[#ef4444] rounded-[5px] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Simulate Cut
            </button>
            <button 
              onClick={handleReset}
              className="px-3 py-1.5 text-[11px] text-[var(--text-primary)] bg-transparent border border-[var(--border-default)] rounded-[5px] hover:bg-[var(--depth-3)] transition-colors"
            >
              Reset
            </button>
          </div>

          <div className="mt-2 text-[11px] bg-[var(--depth-0)] border border-[var(--border-subtle)] rounded-[6px] p-3 min-h-[55px] flex flex-col justify-center">
            {!isRunning ? (
              <span className="text-[var(--text-muted)]">Select a cable and click Simulate Cut...</span>
            ) : (
              <div className="flex flex-col gap-0.5">
                <span>
                  <strong style={{ color: 'var(--accent-red)' }}>{severedCable?.name}</strong> severed.
                </span>
                <span className="text-[var(--text-muted)]">
                  -{severedCable?.capacityTbps} Tbps offline capacity.
                </span>
                <span style={{ color: severityColor }} className="font-semibold uppercase text-[10px] mt-1">
                  {severity} Warning: {severity === 'critical' ? 'Severe regional exposure' : 'Capacity diverted'}
                </span>
              </div>
            )}
          </div>
        </div>
      </Panel>
      <div className="w-[1px] bg-[var(--border-subtle)] shrink-0" />
      
      <Panel title="AFFECTED LANDING POINTS">
        <div className="mt-2 text-[12px] overflow-y-auto max-h-[140px] sidebar-scroll pr-2">
          {!isRunning ? (
            <span className="text-[var(--text-muted)]">—</span>
          ) : (
            <ul className="flex flex-col gap-2">
              {affectedLPs.map(lp => {
                const c = COUNTRIES.find(x => x.id === lp.countryId);
                return (
                  <li key={lp.id} className="text-[var(--text-primary)] truncate">
                    <span className="text-[var(--accent-blue)] mr-1">•</span> {lp.name} ({c?.code})
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </Panel>
      <div className="w-[1px] bg-[var(--border-subtle)] shrink-0" />
      
      <Panel title="REROUTE OPTIONS">
        <div className="mt-2 text-[12px] overflow-y-auto max-h-[140px] sidebar-scroll pr-2">
          {!isRunning ? (
            <span className="text-[var(--text-muted)]">—</span>
          ) : reroutes.length > 0 ? (
            <ul className="flex flex-col gap-2">
              {reroutes.map(c => (
                <li key={c.id} className="text-[var(--text-primary)]">
                  <span className="text-[var(--accent-green)] mr-1">•</span> {c.name} — {c.capacityTbps}T <span className="text-[var(--text-muted)] block pl-3 text-[10px]">(est. 82% capacity headroom)</span>
                </li>
              ))}
            </ul>
          ) : (
            <span style={{ color: 'var(--accent-red)' }}>No active alternate routes in this region.</span>
          )}
        </div>
      </Panel>
    </>
  );
}
</file>

