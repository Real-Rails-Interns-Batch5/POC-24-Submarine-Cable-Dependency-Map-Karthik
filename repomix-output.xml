<file path="components/map/LandingPoints.tsx">
import React from 'react';
import { LandingPoint, Cable } from '@/lib/types';
import { LANDING_POINTS } from '@/lib/constants';
import { projectCoordinates } from './CableMap';

export function LandingPoints({ cables, setTooltip }: any) {
  const activeLpIds = new Set<string>();
  cables.forEach((c: Cable) => {
    c.landingPoints.forEach(lp => activeLpIds.add(lp));
  });

  const lps = LANDING_POINTS.filter(lp => activeLpIds.has(lp.id));

  const handleMouseEnter = (lp: LandingPoint, e: React.MouseEvent) => {
    setTooltip((prev: any) => ({ ...prev, show: true, type: 'lp', data: lp }));
  };

  return (
    <g>
      {lps.map(lp => {
        const [x, y] = projectCoordinates(lp.coordinates[0], lp.coordinates[1]);
        
        // Count cables connected to this LP to determine node size
        const cableCount = cables.filter((c: Cable) => c.landingPoints.includes(lp.id)).length;
        
        let r = 3;
        let fill = '#101e38';
        let stroke = '#1e3a5f';
        let sw = 0.8;
        
        if (cableCount >= 3) {
          r = 6;
          stroke = '#60a5fa';
          sw = 1.5;
        } else if (cableCount === 2) {
          r = 4;
          stroke = '#3b82f6';
          sw = 1;
        }

        return (
          <g 
            key={lp.id} 
            transform={`translate(${x}, ${y})`}
            className="cursor-pointer"
            onMouseEnter={(e) => handleMouseEnter(lp, e)}
            onMouseLeave={() => setTooltip((prev: any) => ({ ...prev, show: false }))}
          >
            {/* Outer ring animation */}
            <circle 
              r={r + 4} 
              fill="none" 
              stroke="#3b82f6" 
              strokeWidth="0.8" 
              opacity="0.3"
            >
              <animate attributeName="r" values={`${r+2};${r+6};${r+2}`} dur="3s" repeatCount="indefinite" />
              <animate attributeName="opacity" values="0.3;0.6;0.3" dur="3s" repeatCount="indefinite" />
            </circle>
            
            {/* Inner dot */}
            <circle r={r} fill={fill} stroke={stroke} strokeWidth={sw} />
          </g>
        );
      })}
    </g>
  );
}
