"use client";

import React, { useMemo, useState, useRef } from 'react';
import { useAppState } from '@/components/providers/AppStateProvider';
import { CABLES } from '@/lib/constants';
import { getFilteredCables } from '@/lib/utils';
import { CableRoutes } from './CableRoutes';
import { LandingPoints } from './LandingPoints';
import { OutageMarker } from './OutageMarker';
import { MapTooltip, TooltipState } from './MapTooltip';
import { WorldMapPaths } from './WorldMapPaths';

export function projectCoordinates(lon: number, lat: number): [number, number] {
  const x = (lon + 180) * (900 / 360);
  const y = (90 - lat) * (400 / 180);
  return [x, y];
}

export function CableMap() {
  const { state } = useAppState();
  const { filters, sim } = state;
  const containerRef = useRef<HTMLDivElement>(null);
  
  const [tooltip, setTooltip] = useState<TooltipState>({
    show: false,
    x: 0,
    y: 0,
    type: null,
    data: null
  });

  const filteredCables = useMemo(() => getFilteredCables(CABLES, filters), [filters]);

  const handleMouseMove = (e: React.MouseEvent) => {
    if (!tooltip.show || !containerRef.current) return;
    const rect = containerRef.current.getBoundingClientRect();
    let x = e.clientX - rect.left;
    let y = e.clientY - rect.top;
    
    // EDGE FLIP LOGIC
    if (x + 220 > rect.width) x = x - 230;
    if (y + 180 > rect.height) y = y - 180;
    
    x = Math.max(4, x);
    y = Math.max(4, y);
    
    setTooltip(prev => ({ ...prev, x, y }));
  };

  return (
    <div 
      ref={containerRef}
      className="flex-1 relative overflow-hidden" 
      style={{ background: 'radial-gradient(ellipse at 40% 45%, #0d1b35 0%, #070f1e 100%)' }}
      onMouseMove={handleMouseMove}
    >
      <svg viewBox="0 0 900 400" preserveAspectRatio="xMidYMid meet" className="w-full h-full block">
        <defs>
          <filter id="cableGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter id="lpGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="2" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <WorldMapPaths />

        <CableRoutes 
          cables={filteredCables} 
          setTooltip={setTooltip} 
        />
        
        <LandingPoints 
          cables={filteredCables}
          setTooltip={setTooltip} 
        />

        {sim.running && sim.cableId && (
          <OutageMarker cableId={sim.cableId} />
        )}

        {/* Legend */}
        <g transform="translate(16, 365)">
          <rect width="180" height="24" fill="#0f1629" fillOpacity="0.9" rx="6" stroke="#1e2d4a" />
          
          <line x1="10" y1="12" x2="30" y2="12" stroke="#3b82f6" strokeWidth="2" />
          <text x="35" y="15" fontSize="10" fill="var(--text-muted)">Active</text>
          
          <line x1="75" y1="12" x2="95" y2="12" stroke="#14b8a6" strokeWidth="2" strokeDasharray="4 2" />
          <text x="100" y="15" fontSize="10" fill="var(--text-muted)">Planned</text>
        </g>
        
        <g transform="translate(16, 335)">
          <rect width="180" height="24" fill="#0f1629" fillOpacity="0.9" rx="6" stroke="#1e2d4a" />
          
          <line x1="10" y1="12" x2="30" y2="12" stroke="#ef4444" strokeWidth="2" strokeDasharray="3 2" />
          <text x="35" y="15" fontSize="10" fill="var(--text-muted)">Degraded</text>

          <circle cx="95" cy="12" r="3" fill="#101e38" stroke="#1e3a5f" strokeWidth="1" />
          <circle cx="108" cy="12" r="4" fill="#101e38" stroke="#60a5fa" strokeWidth="1" />
          <text x="118" y="15" fontSize="10" fill="var(--text-muted)">Nodes</text>
        </g>
      </svg>
      
      <MapTooltip tooltip={tooltip} />
    </div>
  );
}
