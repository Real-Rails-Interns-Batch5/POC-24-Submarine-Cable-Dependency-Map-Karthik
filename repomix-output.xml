<file path="components/map/CableRoutes.tsx">
import React from 'react';
import { Cable } from '@/lib/types';
import { useAppState } from '@/components/providers/AppStateProvider';
import { projectCoordinates } from './CableMap';

export function CableRoutes({ cables, setTooltip }: any) {
  const { state, dispatch } = useAppState();

  const handleMouseEnter = (cable: Cable, e: React.MouseEvent) => {
    setTooltip((prev: any) => ({ ...prev, show: true, type: 'cable', data: cable }));
  };
  const handleMouseLeave = () => {
    setTooltip((prev: any) => ({ ...prev, show: false }));
  };

  const handleSelect = React.useCallback((cableId: string, isSelected: boolean) => {
    dispatch({ type: 'SET_SELECTED_CABLE', payload: isSelected ? null : cableId });
  }, [dispatch]);

  return (
    <g>
      {/* Glow Layer (Rendered First) */}
      {cables.map((cable: Cable) => {
        const points = cable.path.map(p => projectCoordinates(p[0], p[1]).join(',')).join(' ');
        return (
          <polyline 
            key={`glow-${cable.id}`}
            points={points}
            fill="none"
            stroke={cable.color}
            strokeWidth="8"
            opacity="0.08"
            filter="url(#cableGlow)"
          />
        );
      })}

      {/* Line Layer */}
      {cables.map((cable: Cable) => {
        const points = cable.path.map(p => projectCoordinates(p[0], p[1]).join(',')).join(' ');
        const isSelected = state.selectedCable === cable.id;
        const opacity = isSelected ? 1 : (state.selectedCable ? 0.12 : 0.75);
        const strokeWidth = isSelected ? 3 : 1.5;
        const dashArray = cable.status === 'planned' ? '6 4' : cable.status === 'under_repair' ? '3 2' : 'none';

        return (
          <g key={`line-${cable.id}`}>
            {isSelected && (
              <polyline
                points={points}
                fill="none"
                stroke={cable.color}
                strokeWidth="10"
                opacity="0.15"
                strokeLinecap="round"
                strokeLinejoin="round"
              />
            )}
            <polyline
              points={points}
              fill="none"
              stroke={cable.status === 'under_repair' ? '#ef4444' : cable.color}
              strokeWidth={strokeWidth}
              opacity={opacity}
              strokeDasharray={dashArray}
              strokeLinecap="round"
              strokeLinejoin="round"
              onMouseEnter={(e) => handleMouseEnter(cable, e)}
              onMouseLeave={handleMouseLeave}
              onClick={() => handleSelect(cable.id, isSelected)}
              className="cursor-pointer"
            />
            {/* Invisible thicker line for easier hit testing */}
            <polyline
              points={points}
              fill="none"
              stroke="transparent"
              strokeWidth="15"
              onMouseEnter={(e) => handleMouseEnter(cable, e)}
              onMouseLeave={handleMouseLeave}
              onClick={() => handleSelect(cable.id, isSelected)}
              className="cursor-pointer"
            />
          </g>
        );
      })}
    </g>
  );
}
