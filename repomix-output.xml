<file path="app/globals.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: #030712;
    --surface: #0B1117;
    --border: #1F2937;
    --primary: #38BDF8;
    --secondary: #818CF8;
    --text-primary: #e5e7eb;
    --text-muted: #9ca3af;
    --accent-red: #ef4444;
    --accent-amber: #f59e0b;
    --accent-green: #10b981;
  }
}

body {
  color: var(--text-primary);
  background: var(--background);
  font-family: 'Inter', sans-serif;
  margin: 0;
  padding: 0;
  overflow: hidden;
}

.sidebar-scroll::-webkit-scrollbar {
  width: 4px;
}

.sidebar-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.sidebar-scroll::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 4px;
}

.sidebar-scroll::-webkit-scrollbar-thumb:hover {
  background: var(--primary);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.animate-fade-in {
  animation: fadeIn 0.2s ease-out forwards;
}

/* Landing point pulse animation — Tier 1 Global Hubs */
@keyframes hubPulse {
  0%   { transform: scale(1);   opacity: 0.7; }
  50%  { transform: scale(2.2); opacity: 0; }
  100% { transform: scale(1);   opacity: 0; }
}

.hub-pulse-ring {
  position: absolute;
  border-radius: 50%;
  border: 1.5px solid #38BDF8;
  animation: hubPulse 2.4s ease-out infinite;
  pointer-events: none;
}

.hub-pulse-ring.ring-2 {
  animation-delay: 0.8s;
}

/* Leaflet map attribution strip */
.leaflet-control-attribution {
  background: rgba(3, 7, 18, 0.75) !important;
  color: #3d4d66 !important;
  font-size: 9px !important;
  border-radius: 4px 0 0 0 !important;
}

.leaflet-control-attribution a {
  color: #64748b !important;
}

/* Ensure map container doesn't bleed */
.leaflet-container {
  background: #030712 !important;
}

/* Landing point tooltip */
.lp-tooltip {
  background: #0B1117;
  border: 1px solid #1F2937;
  color: #e5e7eb;
  font-size: 11px;
  font-family: 'Inter', sans-serif;
  padding: 8px 10px;
  border-radius: 4px;
  white-space: nowrap;
  pointer-events: none;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
}

/* Persistent LP labels */
.lp-permanent-label {
  color: #e2e8f0;
  font-family: 'Inter', sans-serif;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 1px 6px rgba(0,0,0,0.8);
  white-space: nowrap;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  margin-left: 16px;
  margin-top: -10px;
}

.lp-permanent-label span {
  color: #38BDF8;
  font-size: 8px;
  font-weight: 500;
  opacity: 0.9;
}
