<file path="components/map/OutageMarker.tsx">
import React from 'react';
import { CABLES } from '@/lib/constants';
import { projectCoordinates } from './CableMap';

export function OutageMarker({ cableId }: { cableId: string }) {
  const cable = CABLES.find(c => c.id === cableId);
  if (!cable || cable.path.length < 2) return null;

  // Compute midpoint
  const midIndex = Math.floor(cable.path.length / 2);
  const p1 = cable.path[midIndex - 1];
  const p2 = cable.path[midIndex];
  
  const midLon = (p1[0] + p2[0]) / 2;
  const midLat = (p1[1] + p2[1]) / 2;
  const [x, y] = projectCoordinates(midLon, midLat);

  return (
    <g transform={`translate(${x}, ${y})`}>
      {/* Outer Pulse */}
